# ==============================================================================
# RecoverAI — Streamlit Community Cloud Secrets Template
# ==============================================================================
# In Streamlit Community Cloud:
# App Settings -> Secrets -> Paste the contents below with your deployed Render URL.

# URL of the deployed RecoverAI FastAPI REST API on Render
# Example: "https://recoverai-api.onrender.com/api/v1"
RECOVERAI_API_URL = "http://localhost:8000/api/v1"

# Request timeout in seconds for API client calls
API_TIMEOUT_SECONDS = 20
