# ==============================================================================
# RecoverAI — Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as required.
# Default values are safe for local development, demo runs, and container setups.

# --- Application Mode & Safety ---
APP_ENV=production
DEMO_MODE=true
SIMULATION_MODE=true

# --- LLM Provider ---
# Options: "mock" (default, 100% offline & deterministic), "openai"
LLM_PROVIDER=mock
OPENAI_API_KEY=

# --- Database Connection ---
# SQLite (default): sqlite:///./recoverai.db
# PostgreSQL:       postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./recoverai.db

# --- API Gateway & Host Configuration ---
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- CORS Allowed Origins ---
# Comma-separated list of permitted origins. Use specific domains for production.
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://frontend:8501

# --- Streamlit Dashboard Connection ---
# For local execution:    http://localhost:8000/api/v1
# For Docker Compose:     http://backend:8000/api/v1
API_BASE_URL=http://localhost:8000/api/v1
API_TIMEOUT_SECONDS=15

# --- API Pagination & Batching Limits ---
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
MAX_BATCH_SIZE=50

# --- ML Model Artifact Paths ---
MODEL_PATH=ml/artifacts/model.joblib
PREPROCESSOR_PATH=ml/artifacts/preprocessor.joblib
SHAP_PATH=ml/artifacts/shap_explainer.joblib

# --- Recovery Policy & Safety Thresholds ---
HIGH_CONFIDENCE_THRESHOLD=0.65
OUTREACH_THRESHOLD=0.45
MAX_RETRY_ATTEMPTS=3
MIN_RETRY_DELAY_HOURS=4.0
HIGH_VALUE_PAYMENT_THRESHOLD=15000.0
VIP_CLV_THRESHOLD=10000.0

# --- Failure-Specific Retry Delays (Hours) ---
NETWORK_FAILURE_DELAY=4.0
TEMPORARY_GATEWAY_FAILURE_DELAY=4.0
PAYMENT_TIMEOUT_DELAY=4.0
INSUFFICIENT_FUNDS_DELAY=24.0
BANK_DECLINED_DELAY=24.0
DEFAULT_RETRY_DELAY=24.0

# --- Synthetic Data Generation Seed & Volume ---
DATA_SEED=42
NUM_CUSTOMERS=5000
NUM_PAYMENTS=50000
